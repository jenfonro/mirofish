# Required: use a random value with at least 16 characters.
MIROFISH_MASTER_KEY=replace-with-a-random-master-key

# 代理节点在 WebUI 的代理池里手动维护（SOCKS5 / HTTP / HTTPS），没有订阅地址可填。
# 节点连续拨号失败多少次后停用（停用的节点不再分配给账号，测试成功即恢复）：
# MIROFISH_PROXY_FAILURE_THRESHOLD=2
# 可选：默认账号别名（设置后所有请求都固定走该账号，会绕过会话亲和）
# MIROFISH_DEFAULT_ACCOUNT=
# OpenAI 兼容请求未提供 model 时使用；上游容量会变化，可按实际可用模型覆盖。
# MIROFISH_DEFAULT_MODEL=gpt-5.6-luna
# 官方客户端当前使用的上游地址；通常无需修改。旧地址
# mirasim-relay.mirofish.ai 可能只返回目录、但对 Claude 错报无可用上游。
# MIROFISH_AUTH_BASE=https://auth.mirasim.ai
# MIROFISH_RELAY_BASE=https://relay.mirasim.ai
# 会话亲和的过期时间（秒）：同一对话在此时间内保持同一账号，默认 1800。
# MIROFISH_SESSION_TTL=1800
# relay 设备签名使用的客户端版本标识；上游协议变化时可覆盖。
# MIROFISH_MIRASIM_CLIENT_VERSION=0.0.272
# 上游请求携带的产品 locale（抓包中的官方客户端为 zh-HK）。
# MIROFISH_MIRASIM_LOCALE=zh-HK
# Codex 路径统一改写成的 User-Agent（官方桌面端内置 Codex 的抓包值；上游客户端升级时覆盖）。
# MIROFISH_CODEX_USER_AGENT=mirasim/0.150.1 (Mac OS 26.6.2; x86_64) Apple_Terminal/470.2 (mirasim; 0.1.0)
# 0.0.272 模型请求的 relay 元数据封装公钥（上游轮换时覆盖；这是公钥，不是账号凭证）。
# MIROFISH_MIRASIM_SEAL_PUBLIC_KEY=HlyNMMeGXryasYLJuYQ/9ksCD4AYVVy1zXKAtJdpJn4=
# 旧的官方环境变量名称也受支持：MIRASIM_SEAL_PUBKEY=...
# 默认开启；仅联调旧端点时关闭。
# MIROFISH_MIRASIM_SEAL_METADATA=1
# 请求体解压后的最大字节数（默认 8 MiB）
# MIROFISH_MAX_BODY_BYTES=8388608
# 非 Claude CLI 调用方（OpenAI 兼容、第三方 SDK）会被补全为官方客户端指纹，
# 这里覆盖其中的 User-Agent。官方客户端升级后同步更新。
# MIROFISH_CLAUDE_CLI_USER_AGENT=claude-cli/2.1.252 (external, mirasim)
# 上游 HTTP/1.1 连接池。75 秒覆盖官方客户端抓包中约 60 秒后的连接复用。
# MIROFISH_KEEPALIVE_EXPIRY=75
# MIROFISH_MAX_CONNECTIONS=100
# MIROFISH_MAX_KEEPALIVE_CONNECTIONS=20
# 流式模型响应读取超时（秒）。
# MIROFISH_STREAM_READ_TIMEOUT=600

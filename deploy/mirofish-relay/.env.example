# Required: use a random value with at least 16 characters.
MIROFISH_MASTER_KEY=replace-with-a-random-master-key

# Choose exactly one Docker Mihomo source; keep either credential out of source control.
MIROFISH_PROXY_SUBSCRIPTION_URL=https://example.invalid/sub?token=...
# For a static snapshot instead, leave the URL blank, write the raw subscription
# content to ./mihomo-input/subscription.yaml, then set:
# MIROFISH_PROXY_SUBSCRIPTION_FILE=/input/subscription.yaml
# MIROFISH_PROXY_REFRESH_SECONDS=600
# MIROFISH_PROXY_FETCH_TIMEOUT=10
# MIROFISH_PROXY_SUBSCRIPTION_USER_AGENT=mihomo/1.19.0
# MIROFISH_MIHOMO_CONTROLLER_TIMEOUT=5
# MIROFISH_MIHOMO_SELECTOR=MirofishPool
# MIROFISH_MIHOMO_PROVIDER=mirofish
# MIROFISH_PROXY_FAILURE_THRESHOLD=2
# 每个账号独立出口的槽位数量与起始端口（并发能力；账号数超过槽位时共享槽位并串行切换）。
# MIROFISH_MIHOMO_SLOTS=8
# MIROFISH_MIHOMO_SLOT_BASE_PORT=7891
# 可选：默认账号别名
# MIROFISH_DEFAULT_ACCOUNT=
# relay 设备签名使用的客户端版本标识；上游协议变化时可覆盖。
# MIROFISH_MIRASIM_CLIENT_VERSION=0.0.146

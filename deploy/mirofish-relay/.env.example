# Required. Keep the existing key when upgrading an encrypted data volume.
MIROFISH_MASTER_KEY=replace-with-a-random-master-key
# Hard per-window dispatch ceiling; the console persists overrides (10–100%).
MIROFISH_QUOTA_CEILING=0.90
# On-demand quota cache, including failed reads. No background polling.
MIROFISH_LIMITS_TTL=600
MIROFISH_TLS_IMPERSONATE=off
# MIROFISH_DEFAULT_ACCOUNT=
# MIROFISH_DEFAULT_MODEL=gpt-5.6-luna
# MIROFISH_AUTH_BASE=https://auth.mirasim.ai
# MIROFISH_RELAY_BASE=https://relay.mirasim.ai
# MIROFISH_MIRASIM_CLIENT_VERSION=0.0.303
# MIROFISH_CLAUDE_CLI_USER_AGENT=claude-cli/2.1.261 (external, mirasim)
# MIROFISH_CODEX_USER_AGENT=mirasim/0.153.4 (Mac OS 26.6.2; x86_64) Apple_Terminal/470.2 (mirasim; 0.1.0)
# MIROFISH_SESSION_TTL=1800
# MIROFISH_MAX_BODY_BYTES=8388608
# MIROFISH_STREAM_READ_TIMEOUT=600
